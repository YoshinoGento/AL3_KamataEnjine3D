[*.{cpp,h}]
charset = utf-8
# スペルをintellisense上での「エラー」として扱う
spelling_error_severity = error
# スペル判定する範囲（変数名など）と「コメント」に限定する
spelling_checkable_types = identifiers,comments
# 英語辞書に固定する
spelling_languages = en-us
# 今後も使えるように継続の除外辞書指定となる表現
spelling_default_exclusion_dictionary = true
# 除外辞書の指定
spelling_exclusion_path = ./exclusion.dic